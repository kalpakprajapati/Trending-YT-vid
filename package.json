{
  "name": "trending-yt-vid",
  "version": "1.0.0",
  "description": "Automated YouTube content pipeline",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:tech": "tsx src/index.ts run --source rss --category tech --style cinematic",
    "dev:world": "tsx src/index.ts run --source rss --category world --style cinematic",
    "dev:ai": "tsx src/index.ts run --source rss --category ai --style cinematic",
    "dev:science": "tsx src/index.ts run --source rss --category science --style cinematic",
    "setup:flow": "tsx src/scripts/setup-flow.ts",
    "render": "tsx src/index.ts render",
    "fix-videos": "tsx src/scripts/fix-videos.ts",
    "build": "tsup src/index.ts --format esm --dts",
    "pipeline": "tsx src/pipeline.ts",
    "scrape": "tsx src/scripts/scrape.ts",
    "generate-script": "tsx src/scripts/generate-script.ts",
    "generate-voice": "tsx src/scripts/generate-voice.ts",
    "render-video": "tsx src/scripts/render-video.ts",
    "upload": "tsx src/scripts/upload.ts"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@google/genai": "latest",
    "@inquirer/prompts": "^8.5.2",
    "@libsql/client": "^0.6.0",
    "@remotion/bundler": "^4.0.500",
    "@remotion/cli": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "chalk": "^5.3.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.30.10",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^140.0.0",
    "msedge-tts": "^2.0.7",
    "playwright": "^1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0",
    "rss-parser": "^3.13.0",
    "sharp": "^0.33.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "drizzle-kit": "^0.21.2",
    "tsup": "^8.0.2",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  }
}
